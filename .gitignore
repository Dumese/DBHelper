# ===================== Rust 构建产物 =====================
# 占磁盘 ~11G，可随时 `cargo build` 重新生成，绝对不要提交
/target

# ===================== 抓屏 / 临时产物 =====================
/.shots

# ===================== 临时备份（含加密凭据 vault.bin） =====================
/.demo_backup_*

# ===================== 运行时数据 / 日志 / 凭据 =====================
# vault.bin / master.bin 是加密凭据，严禁入库
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
/vault.bin
/master.bin
data/

# ===================== 编辑器 / 系统垃圾 =====================
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.rs.bk
.vscode/
.idea/

# ===================== 安装包产物（若生成在仓库内） =====================
*.msi
*.dmg
*.app

# 注意：Cargo.lock 作为二进制应用【保留并提交】，以保证可复现构建。
